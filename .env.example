# =============================================================================
# ModelWatch-GCP - example environment file
# =============================================================================
# Copy this file to `.env` for local development. NEVER commit `.env` itself.
# In production, configure these values through your platform's secret
# manager (e.g. Google Secret Manager) and not through a .env file.
# -----------------------------------------------------------------------------

# Version tag for the currently deployed model. Surfaces in API responses.
MODEL_VERSION=v1.0.0

# Where the trained model pipeline (joblib) is read from and written to.
MODEL_PATH=models/churn_model.joblib

# Where each served prediction is appended (CSV in local mode).
PREDICTION_LOG_PATH=data/logs/prediction_logs.csv

# Raw dataset used as the drift-detection reference.
RAW_DATA_PATH=data/raw/customer_churn_sample.csv

# Directory where metrics.json, model_report.md and drift_report.md are written.
REPORTS_DIR=reports

# Boundary score between "low" and "medium" drift. "high" begins at 2x this value.
DRIFT_THRESHOLD=0.20

# Random seed for train/test splits and Scikit-learn estimators.
RANDOM_STATE=42

# FastAPI bind options used by run_api.py.
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
